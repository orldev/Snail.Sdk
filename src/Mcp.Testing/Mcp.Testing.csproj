<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Starts a Snail MCP server under test the way a client starts it — the dll beside the tests, or the published
      native program a variable names — so a contract test calls every tool over stdio against either build.
    </Description>
    <PackageTags>mcp;mcp-server;testing;stdio;native-aot</PackageTags>
  </PropertyGroup>

  <!--
    A library of the servers: its public API written down in PublicAPI.*.txt, the package checked against the last
    release (PackageValidationBaselineVersion, set from the first release on), and its symbols in a .snupkg beside it.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.4.1</PackageValidationBaselineVersion>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snail.Sdk.Mcp.Tests" />
  </ItemGroup>

</Project>
