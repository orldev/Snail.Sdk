<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Starts a Snail MCP server under test the way a client starts it — the dll beside the tests, or the published
      native program a variable names — so a contract test calls every tool over stdio against either build.
    </Description>
    <PackageTags>mcp;mcp-server;testing;stdio;native-aot</PackageTags>
  </PropertyGroup>

  <!--
    A library of the servers: its public API written down in PublicAPI.*.txt, the package checked against the last
    release (PackageValidationBaselineVersion, set from the first release on), and its symbols in a .snupkg beside it.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.4.2</PackageValidationBaselineVersion>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- JobReport is the server's: a test reads the job a tool answers with in the shape the server writes it. -->
  <ItemGroup>
    <ProjectReference Include="../Mcp.Hosting/Mcp.Hosting.csproj" />
  </ItemGroup>

  <!--
    InProcessServer is built on the host every HTTP server is built on, so the package takes Snail.Sdk.Mcp.Http and,
    through it, the ASP.NET Core shared framework. It is referenced by test projects only, which run on a machine with
    the SDK, where that framework always is; the servers whose tests start one in process reference Mcp.Http already,
    and a stdio server's tests gain a framework reference and nothing they ship.
  -->
  <ItemGroup>
    <ProjectReference Include="../Mcp.Http/Mcp.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snail.Sdk.Mcp.Tests" />
  </ItemGroup>

</Project>
