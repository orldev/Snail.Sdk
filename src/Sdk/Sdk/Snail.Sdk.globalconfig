# The analyzer rules of every Snail library and server, carried by Snail.Sdk so that they change with a release of the
# package and not by copying a file into thirty-three repositories. Above the SDK's own analysis-level configs
# (global_level -100) and below a repository's .editorconfig, which still wins for the paths it names.
#
# Every category is advice: a rule a newer .NET SDK adds shows as a suggestion the day the SDK moves, and never fails the
# build. The rules the guidelines state, and the performance rules with a measured gain, are named one by one as
# warnings — under warnings as errors, a failed build. See docs/standard.md, "Code style" and "Performance".

is_global = true
global_level = 100

# Every category: advice.
dotnet_analyzer_diagnostic.category-Style.severity = suggestion
dotnet_analyzer_diagnostic.category-CodeQuality.severity = suggestion
dotnet_analyzer_diagnostic.category-Design.severity = suggestion
dotnet_analyzer_diagnostic.category-Documentation.severity = suggestion
dotnet_analyzer_diagnostic.category-Globalization.severity = suggestion
dotnet_analyzer_diagnostic.category-Interoperability.severity = suggestion
dotnet_analyzer_diagnostic.category-Maintainability.severity = suggestion
dotnet_analyzer_diagnostic.category-Naming.severity = suggestion
dotnet_analyzer_diagnostic.category-Performance.severity = suggestion
dotnet_analyzer_diagnostic.category-Reliability.severity = suggestion
dotnet_analyzer_diagnostic.category-Security.severity = suggestion
dotnet_analyzer_diagnostic.category-Usage.severity = suggestion

# Structure: file-scoped namespaces matching the folders, usings outside them and none unused, the formatting.
csharp_style_namespace_declarations = file_scoped
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0160.severity = none
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0130.severity = warning
dotnet_diagnostic.IDE0055.severity = warning

# Collection expressions and primary constructors, as the guidelines require.
dotnet_style_collection_initializer = true
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
csharp_style_prefer_primary_constructors = true
dotnet_diagnostic.IDE0290.severity = warning

# No this., predefined type names, accessibility always written, readonly where it can be. Named one by one: the
# severity written after an option's value is not one the build honours for every rule (IDE0003, IDE0049 were ignored).
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_style_readonly_field = true
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0009.severity = none
dotnet_diagnostic.IDE0049.severity = warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE0044.severity = warning

# Taste: preferences an editor offers, never a failed build.
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_constructors = when_on_single_line
csharp_style_expression_bodied_local_functions = when_on_single_line
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_accessors = true
csharp_style_expression_bodied_lambdas = true
csharp_prefer_braces = true
csharp_style_prefer_pattern_matching = true
csharp_style_prefer_switch_expression = true
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_pattern_matching_over_as_with_null_check = true
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity

# Code breathes: one blank line between members, never two; a block followed by a blank line.
dotnet_style_allow_multiple_blank_lines_experimental = false
dotnet_style_allow_statement_immediately_after_block_experimental = false
csharp_style_allow_embedded_statements_on_same_line_experimental = false
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false

# Hints that argue with choices the code makes on purpose: static on a one-line lambda, a discard arm as a deliberate
# default, a builder appended for its effect, a guard clause rather than a conditional spanning lines.
csharp_prefer_static_anonymous_functions = false
dotnet_diagnostic.IDE0320.severity = none
dotnet_diagnostic.IDE0010.severity = none
dotnet_diagnostic.IDE0072.severity = none
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0046.severity = none

# Naming, as the guidelines state it.
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.private_fields_are_camel_case_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_rule.private_static_readonly_are_pascal_case.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_are_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_readonly_are_pascal_case.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_pascal_case
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I

dotnet_naming_rule.async_methods_end_with_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_with_async.style = async_suffix
dotnet_naming_rule.async_methods_end_with_async.severity = warning
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async

dotnet_naming_rule.members_are_pascal_case.symbols = members
dotnet_naming_rule.members_are_pascal_case.style = pascal_case
dotnet_naming_rule.members_are_pascal_case.severity = warning
dotnet_naming_symbols.members.applicable_kinds = namespace, class, struct, enum, property, method, event, delegate, type_parameter
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.parameters_and_locals_are_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_are_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel_case.severity = warning
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_style.camel_case.capitalization = camel_case

# Strings: every comparison states its StringComparison, as the guidelines require. Culture-sensitive formatting
# (CA1305) is left alone: servers run with invariant globalization, and the rule would ask for it on every ToString.
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA1305.severity = none

# Performance with a measured gain: cached JsonSerializerOptions, SearchValues, one enumeration,
# LoggerMessage — LogDebug paid for its arguments with Debug off — generated regular expressions, sealed internal types.
dotnet_diagnostic.CA1869.severity = warning
dotnet_diagnostic.CA1870.severity = warning
dotnet_diagnostic.CA1851.severity = warning
dotnet_diagnostic.CA1848.severity = warning
dotnet_diagnostic.CA1852.severity = warning
dotnet_diagnostic.SYSLIB1045.severity = warning

# Reliability: disposal of owned fields; async the way the guidelines state it (no .Result or .Wait(), no async void,
# results observed). The async suffix is the naming rule's, not VSTHRD200's.
dotnet_diagnostic.CA2213.severity = warning
dotnet_diagnostic.VSTHRD002.severity = warning
dotnet_diagnostic.VSTHRD100.severity = warning
dotnet_diagnostic.VSTHRD101.severity = warning
dotnet_diagnostic.VSTHRD103.severity = warning
dotnet_diagnostic.VSTHRD110.severity = warning
dotnet_diagnostic.VSTHRD200.severity = none
dotnet_diagnostic.VSTHRD111.severity = none
dotnet_diagnostic.VSTHRD003.severity = none

# The Visual Studio main-thread rules: a server has no UI thread to break them on, and an analyzer whose every rule is
# off is not run. Measured 2026-10-17 with ReportAnalyzer: VSTHRD010 alone took 0.33–0.47 s per project, 15–19 % of all
# analyzer time, to find nothing.
dotnet_diagnostic.VSTHRD001.severity = none
dotnet_diagnostic.VSTHRD004.severity = none
dotnet_diagnostic.VSTHRD010.severity = none
dotnet_diagnostic.VSTHRD012.severity = none

# The owner's rules no .NET analyzer has, and the two the build does not run (Snail.Sdk.Analyzers).
dotnet_diagnostic.S3L0001.severity = warning
dotnet_diagnostic.S3L0002.severity = warning
dotnet_diagnostic.S3L0003.severity = warning
dotnet_diagnostic.S3L0004.severity = warning
dotnet_diagnostic.S3L0005.severity = warning
dotnet_diagnostic.S3L0006.severity = warning
dotnet_diagnostic.S3L0007.severity = warning
dotnet_diagnostic.S3L0008.severity = warning
dotnet_diagnostic.S3L0009.severity = warning
dotnet_diagnostic.S3L0010.severity = warning

# Rules that argue with the guidelines or measure nothing here.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1708.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1062.severity = none
