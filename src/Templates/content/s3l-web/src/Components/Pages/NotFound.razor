@page "/not-found"

@*#if (localization)
<PageTitle>@Messages.NotFound.Title</PageTitle>

<h1 class="text-3xl font-semibold">@Messages.NotFound.Title</h1>
<p class="mt-4 text-slate-600">@Messages.NotFound.Lead</p>
@*#else
<PageTitle>Not found</PageTitle>

<h1 class="text-3xl font-semibold">Not found</h1>
<p class="mt-4 text-slate-600">There is nothing at this address.</p>
@*#endif
