<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A test project of its own, as each server library would have if it stood alone: Jint stays out of Snail.Sdk.Mcp.Tests,
    which tests the libraries every server references, and a program's limits are tested where the engine is.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- A test is named by the sentence it asserts, not documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mcp.Programs\Mcp.Programs.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Testing\Mcp.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- A program of its own, published natively by NativeProgramTests: its sources are not the tests'. -->
  <ItemGroup>
    <Compile Remove="Native/**" />
    <None Remove="Native/**" />
  </ItemGroup>

</Project>
