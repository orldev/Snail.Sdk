<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- A test is named by the sentence it asserts, not documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mcp.Hosting\Mcp.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Http\Mcp.Http.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Testing\Mcp.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Snail.Sdk.Mcp.Hosting" />
  </ItemGroup>

</Project>
